{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.SemanticKernel": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Provider": "ollama",
    "Ollama": {
      "Endpoint": "http://localhost:11434/v1",
      "ChatModel": "qwen2.5:3b",
      "EmbeddingModel": "nomic-embed-text",
      "EmbeddingDimensions": 768
    },
    "Azure": {
      "Endpoint": "",
      "ApiKey": "",
      "ChatDeployment": "gpt-4o-mini",
      "EmbeddingDeployment": "text-embedding-3-small",
      "EmbeddingDimensions": 1536
    }
  },
  "Analyzer": { "Provider": "pdfpig", "Endpoint": "", "ApiKey": "" },
  "Storage": { "ConnectionString": "UseDevelopmentStorage=true", "Container": "documents", "Queue": "ingest" },
  "Postgres": { "ConnectionString": "Host=localhost;Port=5434;Username=docs;Password=docs;Database=docs" },
  "Auth": {
    "Mode": "dev",
    "Dev": { "Issuer": "docassistant-dev", "Audience": "docassistant", "SigningKey": "dev-only-signing-key-change-me-0123456789", "LifetimeMinutes": 480 }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "RateLimits": { "AskPerMinute": 30, "UploadPerMinute": 20 },
  "Cors": { "Origins": [ "http://localhost:5173" ] },
  "KeyVault": { "Uri": "" }
}
