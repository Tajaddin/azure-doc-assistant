# Copy to .env for docker compose. Every value is optional; the defaults run against Ollama on the host.

# Model provider: ollama (local, free) | azure (Azure OpenAI) | fake (deterministic, no model)
AI_PROVIDER=ollama
OLLAMA_ENDPOINT=http://host.docker.internal:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=            # leave empty in Azure: the managed identity is used

# Document analysis: pdfpig (local) | azure (Document Intelligence; set Analyzer__Endpoint and credentials in compose)
ANALYZER_PROVIDER=pdfpig

# Development auth signing key (HS256, 32+ bytes). Generate one: openssl rand -base64 48
DEV_SIGNING_KEY=dev-only-signing-key-change-me-0123456789

POSTGRES_PASSWORD=docs
GRAFANA_ADMIN_PASSWORD=change-me

# Rate limits per user
ASK_PER_MINUTE=30
UPLOAD_PER_MINUTE=20

# Observability (set with --profile observability)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # http/protobuf; compose sets the protocol

# Host ports
API_PORT=8080
POSTGRES_PORT=5434
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
WORKER_METRICS_PORT=9464
GRAFANA_PORT=3003
PROMETHEUS_PORT=9092
ALERTMANAGER_PORT=9095
TEMPO_PORT=3202
