// Document assistant on Azure: storage, Postgres (pgvector), Azure OpenAI, Document Intelligence, Key Vault,
// Application Insights, the API on App Service, the ingestion Function and the Static Web App.
// Deploy:  az deployment sub create -l eastus -f main.bicep -p main.bicepparam
// Destroy: az group delete -n <resourceGroup> --yes   (teardown.sh)
targetScope = 'subscription'

@description('Short name used as a prefix for every resource')
@minLength(3)
@maxLength(12)
param name string = 'docassist'

@description('Deployment region. Azure OpenAI model availability varies by region; eastus2 and swedencentral have the widest coverage.')
param location string = 'eastus2'

@description('Resource group to create')
param resourceGroupName string = 'rg-${name}'

@description('Entra ID tenant id for API authentication')
param tenantId string = subscription().tenantId

@description('Application (client) id of the API app registration (created manually; see docs/DEPLOY.md)')
param apiClientId string

@description('Application (client) id of the SPA app registration')
param spaClientId string

@description('GitHub repository (owner/name) allowed to deploy through OIDC')
param githubRepository string

@description('Postgres administrator password (generated by the deploy script and stored in Key Vault)')
@secure()
param postgresPassword string

@description('Chat model deployment')
param chatModel object = { name: 'gpt-4o-mini', version: '2024-07-18', capacity: 30 }

@description('Embedding model deployment')
param embeddingModel object = { name: 'text-embedding-3-small', version: '1', capacity: 30 }

@description('App Service plan SKU. F1 is free (60 CPU minutes a day); B1 is about $13 a month.')
param appServiceSku string = 'F1'

var tags = { project: name, managed: 'bicep' }

resource rg 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: resourceGroupName
  location: location
  tags: tags
}

module resources 'resources.bicep' = {
  name: '${name}-resources'
  scope: rg
  params: {
    name: name
    location: location
    tenantId: tenantId
    apiClientId: apiClientId
    spaClientId: spaClientId
    githubRepository: githubRepository
    postgresPassword: postgresPassword
    chatModel: chatModel
    embeddingModel: embeddingModel
    appServiceSku: appServiceSku
    tags: tags
  }
}

output resourceGroup string = rg.name
output apiUrl string = resources.outputs.apiUrl
output staticWebAppUrl string = resources.outputs.staticWebAppUrl
output staticWebAppName string = resources.outputs.staticWebAppName
output functionAppName string = resources.outputs.functionAppName
output apiAppName string = resources.outputs.apiAppName
output keyVaultName string = resources.outputs.keyVaultName
output openAiEndpoint string = resources.outputs.openAiEndpoint
output deployIdentityClientId string = resources.outputs.deployIdentityClientId
